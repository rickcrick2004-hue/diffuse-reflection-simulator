    function resetAllQuizzes() {
      [1, 2, 3].forEach(n => {
        document.getElementById(`quiz-ans-${n}`).classList.add('hidden');
      });
    }

    // =========================================================================
    // メインキャンバス描画（鏡の反射ボックス ＆ 乱反射ボックス）
    // =========================================================================
    function drawExperimentBox(cfg) {
      const { x, y, w, h, title, badgeText, roughness, isTargetForLoupe } = cfg;

      ctx.save();
      // ボックス枠とクリッピング
      ctx.beginPath();
      ctx.roundRect(x, y, w, h, 16);
      ctx.fillStyle = '#070b12';
      ctx.fill();
      ctx.strokeStyle = roughness <= 0.05 ? 'rgba(56, 189, 248, 0.45)' : 'rgba(245, 158, 11, 0.45)';
      ctx.lineWidth = 2;
      ctx.stroke();
      ctx.clip();

      // 背景グリッド
      ctx.strokeStyle = 'rgba(148, 163, 184, 0.07)';
      ctx.lineWidth = 1;
      for (let gx = x; gx < x + w; gx += 32) {
        ctx.beginPath();
        ctx.moveTo(gx, y);
        ctx.lineTo(gx, y + h);
        ctx.stroke();
      }
      for (let gy = y; gy < y + h; gy += 32) {
        ctx.beginPath();
        ctx.moveTo(x, gy);
        ctx.lineTo(x + w, gy);
        ctx.stroke();
      }

      // 反射面の基準高さと横幅
      const surfaceY = y + h * 0.79;
      const padX = w * 0.07;
      const startX = x + padX;
      const endX = x + w - padX;
      const spanW = endX - startX;

      // 観察者3人（左・中央・右の目アイコン）の位置
      const observers = [
        { id: '左の人', short: '左', x: x + w * 0.25, y: y + 66, hit: false },
        { id: '中の人', short: '中', x: x + w * 0.56, y: y + 54, hit: false },
        { id: '右の人', short: '右', x: x + w * 0.85, y: y + 70, hit: false }
      ];

      // 1. 反射面（鏡 または 凸凹面）の描画
      const segs = 150;
      ctx.beginPath();
      for (let i = 0; i <= segs; i++) {
        const u = i / segs;
        const px = startX + u * spanW;
        const { dy } = getSurfaceGeometry(u, spanW, roughness);
        const py = surfaceY + dy;
        if (i === 0) ctx.moveTo(px, py);
        else ctx.lineTo(px, py);
      }
      ctx.lineTo(endX, y + h);
      ctx.lineTo(startX, y + h);
      ctx.closePath();

      const grad = ctx.createLinearGradient(0, surfaceY - 15, 0, y + h);
      if (roughness <= 0.05) {
        grad.addColorStop(0, 'rgba(56, 189, 248, 0.45)');
        grad.addColorStop(0.25, 'rgba(15, 23, 42, 0.95)');
        grad.addColorStop(1, '#020617');
      } else {
        grad.addColorStop(0, 'rgba(226, 232, 240, 0.42)');
        grad.addColorStop(0.3, 'rgba(51, 65, 85, 0.9)');
        grad.addColorStop(1, '#0f172a');
      }
      ctx.fillStyle = grad;
      ctx.fill();

      // 表面の太い輪郭線
      ctx.beginPath();
      for (let i = 0; i <= segs; i++) {
        const u = i / segs;
        const px = startX + u * spanW;
        const { dy } = getSurfaceGeometry(u, spanW, roughness);
        const py = surfaceY + dy;
        if (i === 0) ctx.moveTo(px, py);
        else ctx.lineTo(px, py);
      }
      ctx.strokeStyle = roughness <= 0.05 ? '#7dd3fc' : '#f8fafc';
      ctx.lineWidth = 4;
      ctx.stroke();

      // 鏡のハッチング（斜線）
      if (roughness <= 0.05) {
        ctx.strokeStyle = 'rgba(125, 211, 252, 0.4)';
        ctx.lineWidth = 1.8;
        for (let hx = startX + 10; hx < endX - 6; hx += 16) {
          ctx.beginPath();
          ctx.moveTo(hx, surfaceY);
          ctx.lineTo(hx - 8, surfaceY + 12);
          ctx.stroke();
        }
      }

      // 面の下部に大きくわかりやすい説明テキストを表示
      ctx.fillStyle = roughness <= 0.05 ? '#7dd3fc' : '#fde68a';
      ctx.font = '900 14px "M PLUS Rounded 1c"';
      ctx.textAlign = 'center';
      const surfDesc = roughness <= 0.05
        ? '🪞 平らな鏡の面（どこも真上が垂直）'
        : '📄 凸凹な面（場所によって斜面の傾きが違う）';
      ctx.fillText(surfDesc, x + w / 2, y + h - 12);

      // 2. レーザーポインターと各光線の反射計算
      const rad = (state.laserAngleDeg * Math.PI) / 180;
      const dirX = Math.sin(rad);
      const dirY = Math.cos(rad);
      const perpX = -dirY;
      const perpY = dirX;

      const targetCenterX = startX + state.laserPosRatio * spanW;
      const targetCenterY = surfaceY;

      const distToPointer = Math.min(w, h) * 0.55;
      const laserCenterX = targetCenterX - dirX * distToPointer;
      const laserCenterY = targetCenterY - dirY * distToPointer;

      const beamSpread = state.rayCount === 1 ? 0 : (state.rayCount === 5 ? 52 : 66);
      const raysList = [];

      for (let i = 0; i < state.rayCount; i++) {
        const offsetRatio = state.rayCount === 1 ? 0 : (i / (state.rayCount - 1)) - 0.5;
        const shift = offsetRatio * beamSpread;

        const rayStartX = laserCenterX + perpX * shift + dirX * 30;
        const rayStartY = laserCenterY + perpY * shift + dirY * 30;

        // 表面との交点を反復計算で正確に求める
        let tHit = (surfaceY - rayStartY) / dirY;
        let hitX = rayStartX + dirX * tHit;
        let hitU = Math.max(0.03, Math.min(0.97, (hitX - startX) / spanW));

        for (let iter = 0; iter < 4; iter++) {
          const { dy } = getSurfaceGeometry(hitU, spanW, roughness);
          tHit = ((surfaceY + dy) - rayStartY) / dirY;
          hitX = rayStartX + dirX * tHit;
          hitU = Math.max(0.03, Math.min(0.97, (hitX - startX) / spanW));
        }

        const { dy, slope } = getSurfaceGeometry(hitU, spanW, roughness);
        const hitY = surfaceY + dy;
        hitX = startX + hitU * spanW;

        // 単位接線ベクトル T = (tx, ty) と 単位法線ベクトル N = (nx, ny)
        const len = Math.hypot(1, slope);
        const tx = 1 / len;
        const ty = slope / len;
        const nx = slope / len;
        const ny = -1 / len;

        // 反射ベクトル R = I - 2(I・N)N（厳密な反射の法則）
        const dotIN = dirX * nx + dirY * ny;
        const refX = dirX - 2 * dotIN * nx;
        const refY = dirY - 2 * dotIN * ny;

        // 入射角（＝反射角）の度数
        const cosInc = Math.max(-1, Math.min(1, -(dirX * nx + dirY * ny)));
        const localAngleDeg = (Math.acos(cosInc) * 180) / Math.PI;
        const slopeAngleDeg = (Math.atan(slope) * 180) / Math.PI;

        // 観察者の目に光線が届くかチェック
        const maxRefLength = Math.hypot(w, h) * 0.95;
        for (const obs of observers) {
          const vx = obs.x - hitX;
          const vy = obs.y - hitY;
          const proj = vx * refX + vy * refY;
          if (proj > 0) {
            const perpDist = Math.abs(vx * refY - vy * refX);
            if (perpDist < 32) {
              obs.hit = true;
            }
          }
        }

        raysList.push({
          index: i,
          rayStartX, rayStartY,
          hitX, hitY,
          dirX, dirY,
          refX, refY,
          nx, ny,
          tx, ty,
          localAngleDeg,
          slopeAngleDeg,
          maxRefLength
        });
      }

      if (isTargetForLoupe) {
        state.activeRaysData = raysList;
      }

      // 3. 光線・小さな鏡プレート・法線・角度・光の粒の描画
      const inRatio = Math.min(1.0, state.shootProgress);
      const outRatio = Math.max(0.0, Math.min(1.0, state.shootProgress - 1.0));
      const circledNums = ['①', '②', '③', '④', '⑤', '⑥', '⑦'];

      for (const ray of raysList) {
        const isSelected = isTargetForLoupe && (ray.index === state.selectedRayIdx);

        // (A) 凸凹の各点にある「小さな鏡（接面プレート）」を大きく描画
        if (state.showTangents && inRatio >= 0.95) {
          const plateHalf = isSelected ? 22 : (state.rayCount === 7 ? 13 : 17);
          ctx.save();
          ctx.beginPath();
          ctx.moveTo(ray.hitX - ray.tx * plateHalf, ray.hitY - ray.ty * plateHalf);
          ctx.lineTo(ray.hitX + ray.tx * plateHalf, ray.hitY + ray.ty * plateHalf);
          ctx.strokeStyle = isSelected ? '#22d3ee' : 'rgba(34, 211, 238, 0.85)';
          ctx.lineWidth = isSelected ? 6 : 4;
          ctx.lineCap = 'round';
          ctx.stroke();
          ctx.restore();
        }

        // (B) 法線（小さな鏡に垂直な点線）を描画
        if (state.showNormals && inRatio >= 0.95) {
          const normLen = isSelected ? 82 : 64;
          ctx.save();
          ctx.beginPath();
          ctx.setLineDash([5, 4]);
          ctx.moveTo(ray.hitX, ray.hitY);
          ctx.lineTo(ray.hitX + ray.nx * normLen, ray.hitY + ray.ny * normLen);
          ctx.strokeStyle = isSelected ? '#34d399' : 'rgba(52, 211, 153, 0.75)';
          ctx.lineWidth = isSelected ? 3 : 2;
          ctx.stroke();
          ctx.restore();
        }

        // (C) 入射角と反射角の扇形（アーク）を描画
        if (state.showAngles && inRatio >= 0.98 && (state.rayCount <= 5 || isSelected)) {
          const radius = isSelected ? 36 : 24;
          const normAng = Math.atan2(ray.ny, ray.nx);
          const incRevAng = Math.atan2(-ray.dirY, -ray.dirX);
          const refAng = Math.atan2(ray.refY, ray.refX);

          drawSectorArc(ctx, ray.hitX, ray.hitY, radius, incRevAng, normAng, 'rgba(244, 63, 94, 0.32)', '#f43f5e');
          drawSectorArc(ctx, ray.hitX, ray.hitY, radius, normAng, refAng, 'rgba(251, 191, 36, 0.32)', '#fbbf24');
        }

        // (D) 入射レーザー光線
        const curHitX = ray.rayStartX + (ray.hitX - ray.rayStartX) * inRatio;
        const curHitY = ray.rayStartY + (ray.hitY - ray.rayStartY) * inRatio;

        ctx.save();
        ctx.beginPath();
        ctx.moveTo(ray.rayStartX, ray.rayStartY);
        ctx.lineTo(curHitX, curHitY);
        ctx.strokeStyle = isSelected ? '#fb7185' : '#f43f5e';
        ctx.lineWidth = isSelected ? 4.5 : 3;
        ctx.shadowColor = '#f43f5e';
        ctx.shadowBlur = isSelected ? 12 : 6;
        ctx.stroke();
        ctx.restore();

        // (E) 反射レーザー光線
        if (outRatio > 0) {
          const curRefLen = ray.maxRefLength * outRatio;
          const refEndX = ray.hitX + ray.refX * curRefLen;
          const refEndY = ray.hitY + ray.refY * curRefLen;

          ctx.save();
          ctx.beginPath();
          ctx.moveTo(ray.hitX, ray.hitY);
          ctx.lineTo(refEndX, refEndY);
          ctx.strokeStyle = isSelected ? '#fef08a' : '#fbbf24';
          ctx.lineWidth = isSelected ? 4.5 : 3;
          ctx.shadowColor = '#fbbf24';
          ctx.shadowBlur = isSelected ? 12 : 6;
          ctx.stroke();
          ctx.restore();

          // 反射光の進行方向を示す大きな矢印
          if (outRatio > 0.3) {
            const arrowDist = Math.min(95, curRefLen * 0.55);
            drawArrowHead(
              ctx,
              ray.hitX + ray.refX * arrowDist,
              ray.hitY + ray.refY * arrowDist,
              ray.refX,
              ray.refY,
              isSelected ? '#fef08a' : '#fbbf24',
              isSelected ? 1.35 : 1.05
            );
          }
        }

        // (F) 光が進んでいく様子を表す「光の粒（アニメーションドット）」
        const inDist = Math.hypot(ray.hitX - ray.rayStartX, ray.hitY - ray.rayStartY);
        const stepDist = 42;

        // 入射光上の光の粒
        ctx.fillStyle = '#ffffff';
        for (let d = (state.particlePhase % stepDist); d < inDist * inRatio; d += stepDist) {
          const px = ray.rayStartX + ray.dirX * d;
          const py = ray.rayStartY + ray.dirY * d;
          ctx.beginPath();
          ctx.arc(px, py, isSelected ? 4.2 : 3.2, 0, Math.PI * 2);
          ctx.fill();
        }

        // 反射光上の光の粒
        if (outRatio > 0) {
          const maxOutDist = ray.maxRefLength * outRatio;
          ctx.fillStyle = '#fef08a';
          for (let d = (state.particlePhase % stepDist); d < maxOutDist; d += stepDist) {
            const px = ray.hitX + ray.refX * d;
            const py = ray.hitY + ray.refY * d;
            if (px >= x && px <= x + w && py >= y && py <= y + h) {
              ctx.beginPath();
              ctx.arc(px, py, isSelected ? 4.2 : 3.2, 0, Math.PI * 2);
              ctx.fill();
            }
          }
        }

        // (G) 当たった点のハイライト丸枠と番号ラベル
        if (inRatio >= 0.98) {
          ctx.beginPath();
          ctx.arc(ray.hitX, ray.hitY, isSelected ? 7 : 4.5, 0, Math.PI * 2);
          ctx.fillStyle = isSelected ? '#22d3ee' : '#fde047';
          ctx.fill();

          if (isSelected) {
            ctx.beginPath();
            ctx.arc(ray.hitX, ray.hitY, 18, 0, Math.PI * 2);
            ctx.strokeStyle = '#22d3ee';
            ctx.lineWidth = 2.5;
            ctx.stroke();

            // 拡大中バッジ
            ctx.fillStyle = '#22d3ee';
            ctx.font = '900 13px "M PLUS Rounded 1c"';
            ctx.textAlign = 'center';
            ctx.fillText(`🔎${circledNums[ray.index]}拡大中`, ray.hitX, ray.hitY + 32);
          }
        }
      }

      // 4. 大型レーザーポインター本体の描画
      drawBigLaserPointer(ctx, laserCenterX, laserCenterY, dirX, dirY, beamSpread);

      // 5. 観察者の目（左・中・右）の大型アイコン描画
      for (const obs of observers) {
        drawBigObserver(ctx, obs.x, obs.y, obs.id, obs.hit && outRatio > 0.45);
      }

      // 6. ボックス左上の大型タイトル看板
      ctx.fillStyle = 'rgba(15, 23, 42, 0.92)';
      ctx.beginPath();
      ctx.roundRect(x + 10, y + 8, Math.min(w - 20, 290), 36, 10);
      ctx.fill();
      ctx.strokeStyle = roughness <= 0.05 ? '#38bdf8' : '#f59e0b';
      ctx.lineWidth = 1.5;
      ctx.stroke();

      ctx.textAlign = 'left';
      ctx.font = '900 15px "M PLUS Rounded 1c"';
      ctx.fillStyle = roughness <= 0.05 ? '#38bdf8' : '#fbbf24';
      ctx.fillText(`${title}  `, x + 18, y + 31);

      ctx.restore();
      return observers;
    }

    // 扇形アークを描画するヘルパー
    function drawSectorArc(c, cx, cy, r, a1, a2, fill, stroke) {
      let diff = a2 - a1;
      while (diff > Math.PI) diff -= Math.PI * 2;
      while (diff < -Math.PI) diff += Math.PI * 2;
      c.save();
      c.beginPath();
      c.moveTo(cx, cy);
      c.arc(cx, cy, r, a1, a1 + diff, diff < 0);
      c.closePath();
      c.fillStyle = fill;
      c.fill();
      c.strokeStyle = stroke;
      c.lineWidth = 2;
      c.stroke();
      c.restore();
    }

    // 光線の矢印を描画するヘルパー
    function drawArrowHead(c, x, y, dx, dy, color, scale = 1) {
      const ang = Math.atan2(dy, dx);
      c.save();
      c.translate(x, y);
      c.rotate(ang);
      c.scale(scale, scale);
      c.beginPath();
      c.moveTo(8, 0);
      c.lineTo(-6, -6);
      c.lineTo(-3.5, 0);
      c.lineTo(-6, 6);
      c.closePath();
      c.fillStyle = color;
      c.fill();
      c.restore();
    }

    // 大型レーザーポインター本体を描画
    function drawBigLaserPointer(c, px, py, dirX, dirY, spread) {
      const ang = Math.atan2(dirY, dirX);
      const bodyW = 68;
      const bodyH = Math.max(32, spread + 22);

      c.save();
      c.translate(px, py);
      c.rotate(ang);

      // 本体ボックス
      c.fillStyle = '#1e293b';
      c.strokeStyle = '#f43f5e';
      c.lineWidth = 3;
      c.beginPath();
      c.roundRect(-bodyW / 2, -bodyH / 2, bodyW, bodyH, 10);
      c.fill();
      c.stroke();

      // 照射口（赤い発光部）
      c.fillStyle = '#f43f5e';
      c.beginPath();
      c.roundRect(bodyW / 2 - 10, -bodyH / 2 + 4, 10, bodyH - 8, 4);
      c.fill();

      // 文字ラベル
      c.fillStyle = '#ffffff';
      c.font = '900 12px "M PLUS Rounded 1c"';
      c.textAlign = 'center';
      c.textBaseline = 'middle';
      c.fillText('🔦レーザー', -4, 0);

      c.restore();
    }

    // 観察者の目アイコン（大きく見やすいピル型）を描画
    function drawBigObserver(c, ox, oy, label, isVisible) {
      c.save();
      const boxW = 92;
      const boxH = 38;
      c.beginPath();
      c.roundRect(ox - boxW / 2, oy - boxH / 2, boxW, boxH, 19);
      if (isVisible) {
        c.fillStyle = 'rgba(250, 204, 21, 0.28)';
        c.strokeStyle = '#facc15';
        c.lineWidth = 2.5;
      } else {
        c.fillStyle = 'rgba(15, 23, 42, 0.88)';
        c.strokeStyle = 'rgba(100, 116, 139, 0.5)';
        c.lineWidth = 1.5;
      }
      c.fill();
      c.stroke();

      c.textAlign = 'center';
      c.font = '900 12px "M PLUS Rounded 1c"';
      c.fillStyle = isVisible ? '#fef08a' : '#94a3b8';
      c.fillText(`👀 ${label}`, ox, oy - 4);

      c.font = '900 11px "M PLUS Rounded 1c"';
      c.fillStyle = isVisible ? '#4ade80' : '#64748b';
      c.fillText(isVisible ? '✨見える！' : '届かない', ox, oy + 11);
      c.restore();
    }

    // キャンバス下部の観察者ステータス表示を更新
    function updateObserverStatusUI(mirrorObs, diffuseObs) {
      const mEl = document.getElementById('status-mirror-eyes');
      const dEl = document.getElementById('status-diffuse-eyes');
      if (!mEl || !dEl) return;

      const makePills = (arr) => arr.map(o => {
        if (o.hit) {
          return `<span class="px-2.5 py-1 rounded-lg text-xs font-black bg-amber-400 text-slate-950 shadow">👀${o.short}:見える✨</span>`;
        } else {
          return `<span class="px-2.5 py-1 rounded-lg text-xs font-bold bg-slate-800 text-slate-500 border border-slate-700">👀${o.short}:－</span>`;
        }
      }).join('');

      if (mirrorObs) mEl.innerHTML = makePills(mirrorObs);
      if (diffuseObs) dEl.innerHTML = makePills(diffuseObs);
    }

    // =========================================================================
    // 右パネル：特大ミクロ拡大ルーペの描画
    // =========================================================================
    function renderBigMicroLoupe() {
      const dpr = window.devicePixelRatio || 1;
      const mw = microCanvas.width / dpr;
      const mh = microCanvas.height / dpr;

      microCtx.clearRect(0, 0, mw, mh);

      const rays = state.activeRaysData;
      if (!rays || rays.length === 0) return;

      const idx = Math.min(state.selectedRayIdx, rays.length - 1);
      const ray = rays[idx];

      const cx = mw * 0.5;
      const cy = mh * 0.78;
      const plateLen = mw * 0.40;

      microCtx.save();

      // 1. 拡大された凸凹の斜面（水色の小さな鏡プレート）
      microCtx.beginPath();
      microCtx.moveTo(cx - ray.tx * plateLen, cy - ray.ty * plateLen);
      microCtx.lineTo(cx + ray.tx * plateLen, cy + ray.ty * plateLen);
      microCtx.lineTo(cx + ray.tx * plateLen, mh + 30);
      microCtx.lineTo(cx - ray.tx * plateLen, mh + 30);
      microCtx.closePath();
      microCtx.fillStyle = 'rgba(34, 211, 238, 0.16)';
      microCtx.fill();

      // 小さな鏡の表面ライン
      microCtx.beginPath();
      microCtx.moveTo(cx - ray.tx * plateLen, cy - ray.ty * plateLen);
      microCtx.lineTo(cx + ray.tx * plateLen, cy + ray.ty * plateLen);
      microCtx.strokeStyle = '#22d3ee';
      microCtx.lineWidth = 6;
      microCtx.lineCap = 'round';
      microCtx.stroke();

      // 2. 法線（その小さな鏡に対して90°垂直な線）
      const normLen = mh * 0.66;
      microCtx.beginPath();
      microCtx.setLineDash([6, 4]);
      microCtx.moveTo(cx, cy);
      microCtx.lineTo(cx + ray.nx * normLen, ray.hitY ? cy + ray.ny * normLen : cy - normLen);
      microCtx.strokeStyle = '#34d399';
      microCtx.lineWidth = 3;
      microCtx.stroke();
      microCtx.setLineDash([]);

      // 法線ラベル
      microCtx.fillStyle = '#34d399';
      microCtx.font = '900 13px "M PLUS Rounded 1c"';
      microCtx.textAlign = 'center';
      microCtx.fillText('法線(垂直90°)', cx + ray.nx * (normLen - 8), cy + ray.ny * (normLen - 8) - 6);

      // 直角マーク
      const sq = 11;
      microCtx.beginPath();
      microCtx.moveTo(cx + ray.tx * sq, cy + ray.ty * sq);
      microCtx.lineTo(cx + ray.tx * sq + ray.nx * sq, cy + ray.ty * sq + ray.ny * sq);
      microCtx.lineTo(cx + ray.nx * sq, cy + ray.ny * sq);
      microCtx.strokeStyle = '#34d399';
      microCtx.lineWidth = 2;
      microCtx.stroke();

      // 3. 入射角と反射角の大きな扇形
      const normAng = Math.atan2(ray.ny, ray.nx);
      const incRevAng = Math.atan2(-ray.dirY, -ray.dirX);
      const refAng = Math.atan2(ray.refY, ray.refX);
      const arcR = Math.min(mw, mh) * 0.28;

      drawSectorArc(microCtx, cx, cy, arcR, incRevAng, normAng, 'rgba(244, 63, 94, 0.38)', '#f43f5e');
      drawSectorArc(microCtx, cx, cy, arcR, normAng, refAng, 'rgba(251, 191, 36, 0.38)', '#fbbf24');

      // 4. 入射光と反射光（太く鮮明に描画）
      const beamLen = Math.min(mw, mh) * 0.72;

      // 入射光
      microCtx.beginPath();
      microCtx.moveTo(cx - ray.dirX * beamLen, cy - ray.dirY * beamLen);
      microCtx.lineTo(cx, cy);
      microCtx.strokeStyle = '#f43f5e';
      microCtx.lineWidth = 4.5;
      microCtx.stroke();

      // 反射光
      microCtx.beginPath();
      microCtx.moveTo(cx, cy);
      microCtx.lineTo(cx + ray.refX * beamLen, cy + ray.refY * beamLen);
      microCtx.strokeStyle = '#fbbf24';
      microCtx.lineWidth = 4.5;
      microCtx.stroke();

      // 角度数値ラベルをキャンバス内にも大きく表示
      const degInt = Math.round(ray.localAngleDeg);
      const midIncAng = (incRevAng + normAng) / 2;
      const midRefAng = (normAng + refAng) / 2;
      const labelR = arcR + 18;

      microCtx.font = '900 14px "M PLUS Rounded 1c"';
      microCtx.fillStyle = '#fda4af';
      microCtx.fillText(`${degInt}°`, cx + Math.cos(midIncAng) * labelR, cy + Math.sin(midIncAng) * labelR);

      microCtx.fillStyle = '#fde047';
      microCtx.fillText(`${degInt}°`, cx + Math.cos(midRefAng) * labelR, cy + Math.sin(midRefAng) * labelR);

      // 反射点ドット
      microCtx.beginPath();
      microCtx.arc(cx, cy, 6, 0, Math.PI * 2);
      microCtx.fillStyle = '#ffffff';
      microCtx.fill();

      microCtx.restore();

      // メーター表示の更新
      const circledNums = ['①', '②', '③', '④', '⑤', '⑥', '⑦'];
      const slopeInt = Math.round(ray.slopeAngleDeg);
      const slopeStr = slopeInt > 0 ? `+${slopeInt}°` : `${slopeInt}°`;

      document.getElementById('micro-slope-badge').textContent =
        `光線 ${circledNums[idx]} の場所：小さな鏡の傾き ${slopeStr}`;
      document.getElementById('big-inc-deg').textContent = `${degInt}°`;
      document.getElementById('big-ref-deg').textContent = `${degInt}°`;
    }

    // =========================================================================
    // キャンバス上のタッチ・ドラッグ操作
    // =========================================================================
    function handleCanvasTouch(e, isMove) {
      const rect = simCanvas.getBoundingClientRect();
      const px = e.clientX - rect.left;
      const py = e.clientY - rect.top;
      const cw = rect.width;
      const ch = rect.height;

      let localX = px;
      let boxW = cw;
      if (state.viewMode === 'compare') {
        boxW = cw / 2;
        if (px > boxW) localX = px - boxW;
      }

      const surfaceY = ch * 0.79;

      // 光が当たった点（反射面付近）をタップしたら、その光線を拡大ルーペの対象にする
      if (!isMove && Math.abs(py - surfaceY) < 48 && state.activeRaysData.length > 1) {
        let bestIdx = state.selectedRayIdx;
        let minDist = 999;
        state.activeRaysData.forEach((r, idx) => {
          const rLocalX = state.viewMode === 'compare' && r.hitX > boxW ? r.hitX - boxW : r.hitX;
          const dist = Math.hypot(localX - rLocalX, py - r.hitY);
          if (dist < minDist) {
            minDist = dist;
            bestIdx = idx;
          }
        });
        if (minDist < 42) {
          state.selectedRayIdx = bestIdx;
          renderRaySelectionButtons();
          return;
        }
      }

      // 上部エリアをタッチ・ドラッグした場合はレーザーの角度と場所を直感的に動かす
      if (py < surfaceY - 20) {
        const relX = Math.max(0.08, Math.min(0.92, localX / boxW));
        const relY = Math.max(0.08, Math.min(0.72, py / ch));

        const newAngle = Math.round(16 + (1 - relY / 0.72) * 58);
        const clampedAngle = Math.max(15, Math.min(80, newAngle));
        const newPos = Math.max(0.18, Math.min(0.78, relX + 0.14));

        state.laserAngleDeg = clampedAngle;
        state.laserPosRatio = newPos;
        document.getElementById('slider-angle').value = clampedAngle;
        document.getElementById('slider-pos').value = newPos;
        onControlInput();
      }
    }

    simCanvas.addEventListener('pointerdown', (e) => {
      state.isDragging = true;
      simCanvas.setPointerCapture(e.pointerId);
      handleCanvasTouch(e, false);
    });

    simCanvas.addEventListener('pointermove', (e) => {
      if (!state.isDragging) return;
      handleCanvasTouch(e, true);
    });

    simCanvas.addEventListener('pointerup', () => {
      state.isDragging = false;
    });

    simCanvas.addEventListener('pointercancel', () => {
      state.isDragging = false;
    });

    // =========================================================================
    // メインアニメーションループ
    // =========================================================================
    function animate() {
      if (state.viewMode !== 'summary') {
        const dpr = window.devicePixelRatio || 1;
        const cw = simCanvas.width / dpr;
        const ch = simCanvas.height / dpr;

        ctx.clearRect(0, 0, cw, ch);

        // 光の粒の進行フェーズ更新
        state.particlePhase = (state.particlePhase + 1.6) % 1000;

        // スロー発射アニメーションの進行
        if (state.isShooting) {
          state.shootProgress += 0.032;
          if (state.shootProgress >= 2.0) {
            state.shootProgress = 2.0;
            state.isShooting = false;
          }
        }

        // 左右自動スキャンモード時の位置更新
        if (state.autoSweep && !state.isDragging) {
          state.laserPosRatio += 0.0018 * state.sweepDir;
          if (state.laserPosRatio >= 0.74) {
            state.laserPosRatio = 0.74;
            state.sweepDir = -1;
          } else if (state.laserPosRatio <= 0.22) {
            state.laserPosRatio = 0.22;
            state.sweepDir = 1;
          }
          document.getElementById('slider-pos').value = state.laserPosRatio;
          document.getElementById('label-pos').textContent = `${Math.round(state.laserPosRatio * 100)}%`;
        }

        if (state.viewMode === 'compare') {
          const gap = 10;
          const halfW = (cw - gap) / 2;

          const mirrorObs = drawExperimentBox({
            x: 0,
            y: 0,
            w: halfW,
            h: ch,
            title: '① 鏡の反射（1方向へそろう）',
            roughness: 0.0,
            isTargetForLoupe: false
          });

          const diffuseObs = drawExperimentBox({
            x: halfW + gap,
            y: 0,
            w: halfW,
            h: ch,
            title: '② 乱反射（あらゆる方向へ広がる）',
            roughness: state.roughness,
            isTargetForLoupe: true
          });

          updateObserverStatusUI(mirrorObs, diffuseObs);
        } else {
          const isFlat = state.roughness <= 0.05;
          const singleObs = drawExperimentBox({
            x: 0,
            y: 0,
            w: cw,
            h: ch,
            title: isFlat
              ? '🪞 平らな鏡の反射（すべての場所で法線が真上）'
              : '📄 凸凹な面の乱反射（それぞれの場所で入射角＝反射角）',
            roughness: state.roughness,
            isTargetForLoupe: true
          });

          updateObserverStatusUI(singleObs, singleObs);
        }

        renderBigMicroLoupe();
      }

      requestAnimationFrame(animate);
    }

    // 起動時初期化
    window.onload = function () {
      resizeAllCanvases();
      renderRaySelectionButtons();
      onControlInput();
      animate();
    };
  </script>
</body>
