    // =========================================================================
    // クイズ判定処理
    // =========================================================================
    const quizMessages = {
      1: {
        ok: '⭕ 大正解！乱反射でも、光が当たる1つ1つのミクロな斜面では必ず「入射角＝反射角」が成り立っています！',
        ng: '💡 注目！乱反射はデタラメに跳ね返るのではなく、1つ1つの場所で「入射角＝反射角」が成り立っています。'
