        card1.classList.remove('hidden');
        card2.classList.add('hidden');
      } else {
        tab2.className = 'py-1.5 rounded-lg text-sm font-black bg-indigo-600 text-white shadow';
        tab1.className = 'py-1.5 rounded-lg text-sm font-black text-slate-400 hover:text-white';
        card2.classList.remove('hidden');
        card1.classList.add('hidden');
      }
