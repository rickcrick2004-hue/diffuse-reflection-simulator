<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
  <title>中1理科：鏡の反射と乱反射 体感シミュレーター</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link href="https://fonts.googleapis.com/css2?family=M+PLUS+Rounded+1c:wght@500;700;800;900&display=swap" rel="stylesheet">
  <style>
    * {
      box-sizing: border-box;
      user-select: none;
      -webkit-user-select: none;
      -webkit-touch-callout: none;
    }
    body {
      font-family: 'M PLUS Rounded 1c', sans-serif;
      background-color: #090d16;
      color: #f8fafc;
      overflow: hidden;
      width: 100vw;
      height: 100vh;
      height: 100dvh;
      margin: 0;
      padding: 0;
    }

    /* iPadの指操作に最適化した大型スライダー */
    input[type="range"] {
      -webkit-appearance: none;
      appearance: none;
      background: #334155;
      height: 12px;
      border-radius: 999px;
      outline: none;
    }
    input[type="range"]::-webkit-slider-thumb {
      -webkit-appearance: none;
      appearance: none;
      width: 30px;
      height: 30px;
      border-radius: 50%;
      background: #38bdf8;
      border: 4px solid #ffffff;
      cursor: pointer;
      box-shadow: 0 3px 8px rgba(0,0,0,0.5);
    }
    .slider-rose::-webkit-slider-thumb {
      background: #f43f5e !important;
    }
    .slider-amber::-webkit-slider-thumb {
      background: #f59e0b !important;
    }

    @keyframes pulseBadge {
      0%, 100% { transform: scale(1); }
      50% { transform: scale(1.04); }
    }
    .pulse-gentle {
      animation: pulseBadge 2.2s infinite ease-in-out;
    }
  </style>
</head>
<body class="flex flex-col w-screen h-screen overflow-hidden bg-slate-950 select-none">

  <!-- ==================== 1. 上部ヘッダー（大きな文字とワンタップ画面切替） ==================== -->
  <header class="h-16 shrink-0 bg-slate-900 border-b-2 border-slate-800 px-4 flex items-center justify-between gap-3 z-20">
    <!-- 左：タイトル -->
    <div class="flex items-center gap-3">
      <div class="bg-gradient-to-br from-rose-500 to-amber-500 text-white font-black px-3.5 py-1.5 rounded-xl text-base shadow-md flex items-center gap-1.5 shrink-0">
        <span>🔦 中1理科</span>
      </div>
      <div>
        <h1 class="text-lg xl:text-xl font-black text-white tracking-tight leading-tight">
          鏡の反射 と 乱反射（らんはんしゃ）のしくみ
        </h1>
      </div>
    </div>

    <!-- 中央：最重要ポイント（大きな文字で常時表示） -->
    <div class="hidden xl:flex items-center gap-2 bg-indigo-950 border-2 border-amber-400/60 px-4 py-1.5 rounded-2xl shadow">
      <span class="text-base font-black text-amber-300">
        💡 大原則：乱反射でも、光が当たる１つ１つの場所では「入射角 ＝ 反射角」が成り立つ！
      </span>
    </div>

    <!-- 右：モード切替ボタン（大きく押しやすいタブ） -->
    <div class="flex items-center bg-slate-800 p-1.5 rounded-2xl border border-slate-700 gap-1.5 shrink-0">
      <button id="tab-compare" onclick="setViewMode('compare')" class="px-4 py-2 rounded-xl text-sm font-black transition-all bg-sky-500 text-white shadow-md">
        ⚖️ 鏡と乱反射を並べて比較
      </button>
      <button id="tab-single" onclick="setViewMode('single')" class="px-4 py-2 rounded-xl text-sm font-black transition-all text-slate-300 hover:text-white">
        🔍 大きく1画面で実験
      </button>
      <button id="tab-summary" onclick="setViewMode('summary')" class="px-4 py-2 rounded-xl text-sm font-black transition-all text-slate-300 hover:text-white">
        📖 大型図解まとめ＆クイズ
      </button>
    </div>
  </header>

  <!-- ==================== 2. メインエリア（iPad横1画面に完全収容） ==================== -->
  <main class="flex-1 min-h-0 grid grid-cols-12 gap-3 p-3 bg-slate-950 overflow-hidden">

    <!-- ========== 左・中央カラム：メイン実験キャンバス ＋ 大型操作パネル (8列) ========== -->
    <section id="sim-column" class="col-span-8 flex flex-col gap-3 min-h-0 h-full">

      <!-- 上：インタラクティブ実験キャンバス枠 -->
      <div class="relative flex-1 min-h-0 bg-slate-900 rounded-2xl border-2 border-slate-800 overflow-hidden flex flex-col shadow-xl">

        <!-- キャンバス上部バー：操作ガイドと「スロー発射」「自動スキャン」アクションボタン -->
        <div class="bg-slate-900/95 border-b border-slate-800 px-3.5 py-2 flex items-center justify-between gap-2 shrink-0 z-10">
          <div class="flex items-center gap-2">
            <span class="text-sm font-extrabold text-slate-200 flex items-center gap-1.5">
              👆 <span class="text-rose-400">赤いレーザー本体</span>を直接ドラッグして動かすか、<span class="text-cyan-300">光が当たった点</span>をタップしよう！
            </span>
          </div>

          <div class="flex items-center gap-2 shrink-0">
            <button onclick="triggerShootAnimation()" class="bg-gradient-to-r from-rose-600 to-amber-500 hover:from-rose-500 hover:to-amber-400 active:scale-95 text-white text-sm font-black px-4 py-1.5 rounded-xl shadow-lg flex items-center gap-1.5 transition">
              <span>🚀 光を発射！（スロー再生）</span>
            </button>
            <button id="btn-auto-sweep" onclick="toggleAutoSweep()" class="bg-slate-800 hover:bg-slate-700 border-2 border-slate-600 text-amber-300 text-sm font-black px-3.5 py-1.5 rounded-xl transition flex items-center gap-1">
              <span>🔄 左右に自動スキャン：OFF</span>
            </button>
          </div>
        </div>

        <!-- HTML5 Canvas 本体 -->
        <div id="canvas-container" class="relative flex-1 min-h-0 w-full h-full">
          <canvas id="simCanvas" class="w-full h-full block cursor-pointer touch-none"></canvas>

          <!-- 1画面モード時のみ左上に表示する「面の種類ワンタッチ切替」大型ボタン -->
          <div id="single-mode-switch" class="hidden absolute top-3 left-3 bg-slate-900/95 backdrop-blur border-2 border-slate-700 p-1.5 rounded-2xl shadow-xl flex items-center gap-1.5 z-10">
            <span class="text-sm font-black text-slate-300 px-2">面の種類：</span>
            <button id="preset-mirror" onclick="setRoughnessPreset(0)" class="px-3.5 py-1.5 rounded-xl text-sm font-black bg-sky-500 text-white shadow">
              🪞 平らな鏡
            </button>
            <button id="preset-wave" onclick="setRoughnessPreset(0.4)" class="px-3.5 py-1.5 rounded-xl text-sm font-black text-slate-300 hover:bg-slate-800">
              🌊 少し凸凹な面
            </button>
            <button id="preset-rough" onclick="setRoughnessPreset(0.9)" class="px-3.5 py-1.5 rounded-xl text-sm font-black text-slate-300 hover:bg-slate-800">
              📄 白い紙・壁（乱反射）
            </button>
          </div>

          <!-- キャンバス内下部の色分け凡例（大きく見やすい文字） -->
          <div class="absolute bottom-2.5 right-3 bg-slate-950/90 backdrop-blur border border-slate-700 rounded-xl px-3.5 py-1.5 flex items-center gap-4 text-xs sm:text-sm font-extrabold pointer-events-none shadow-lg">
            <div class="flex items-center gap-1.5">
              <span class="inline-block w-4 h-1.5 bg-rose-500 rounded-full"></span>
              <span class="text-rose-300">入射光</span>
            </div>
            <div class="flex items-center gap-1.5">
              <span class="inline-block w-4 h-1.5 bg-amber-400 rounded-full"></span>
              <span class="text-amber-300">反射光</span>
            </div>
            <div class="flex items-center gap-1.5">
              <span class="inline-block w-4 h-0.5 border-t-2 border-dashed border-emerald-400"></span>
              <span class="text-emerald-300">法線(垂直)</span>
            </div>
            <div class="flex items-center gap-1.5">
              <span class="inline-block w-4 h-1.5 bg-cyan-400 rounded-full"></span>
              <span class="text-cyan-300">小さな鏡の傾き</span>
            </div>
          </div>
        </div>

        <!-- キャンバス下部：どこから見えるか？（鏡 vs 乱反射 の観察者リアルタイム比較バー） -->
        <div class="bg-slate-950 border-t-2 border-slate-800 px-3.5 py-2 grid grid-cols-2 gap-3 shrink-0">
          <div class="bg-slate-900 border border-sky-500/40 rounded-xl px-3 py-1.5 flex items-center justify-between">
            <div class="flex items-center gap-2">
              <span class="text-xl">🪞</span>
              <div>
                <div class="text-sm font-black text-sky-300">鏡：1方向だけに反射</div>
                <div class="text-xs font-bold text-slate-400">特定の場所の人しか見えない</div>
              </div>
            </div>
            <div id="status-mirror-eyes" class="flex items-center gap-1.5"></div>
          </div>

          <div class="bg-slate-900 border border-amber-500/40 rounded-xl px-3 py-1.5 flex items-center justify-between">
            <div class="flex items-center gap-2">
              <span class="text-xl">📄</span>
              <div>
                <div class="text-sm font-black text-amber-300">乱反射：あらゆる方向へ反射</div>
                <div class="text-xs font-bold text-slate-400">どこに座っている人にも光が届く！</div>
              </div>
            </div>
            <div id="status-diffuse-eyes" class="flex items-center gap-1.5"></div>
          </div>
        </div>
      </div>

      <!-- 下：iPadタッチ操作用 大型コントロールパネル -->
      <div class="h-40 shrink-0 bg-slate-900 rounded-2xl border-2 border-slate-800 p-3 grid grid-cols-12 gap-3 items-center shadow-lg">

        <!-- 1. レーザーの角度・位置スライダー (5列) -->
        <div class="col-span-5 bg-slate-950/80 border border-slate-800 rounded-xl p-3 h-full flex flex-col justify-between">
          <div class="flex items-center justify-between">
            <span class="text-sm font-black text-rose-400">🔦 レーザーの角度と場所</span>
            <div class="flex gap-1">
              <button onclick="setLaserPreset(25, 0.30)" class="bg-slate-800 hover:bg-slate-700 text-xs text-slate-200 px-2.5 py-1 rounded-lg border border-slate-700 font-extrabold">浅く</button>
              <button onclick="setLaserPreset(45, 0.45)" class="bg-slate-800 hover:bg-slate-700 text-xs text-slate-200 px-2.5 py-1 rounded-lg border border-slate-700 font-extrabold">45°</button>
              <button onclick="setLaserPreset(72, 0.52)" class="bg-slate-800 hover:bg-slate-700 text-xs text-slate-200 px-2.5 py-1 rounded-lg border border-slate-700 font-extrabold">深く</button>
            </div>
          </div>

          <!-- 角度スライダー -->
          <div class="flex items-center gap-2.5">
            <label class="text-sm font-extrabold text-slate-200 w-24 shrink-0">当てる角度</label>
            <input id="slider-angle" type="range" min="15" max="80" step="1" value="42" class="w-full slider-rose" oninput="onControlInput()" />
            <span id="label-angle" class="text-base font-black text-rose-400 w-12 text-right">42°</span>
          </div>

          <!-- 場所スライダー -->
          <div class="flex items-center gap-2.5">
            <label class="text-sm font-extrabold text-slate-200 w-24 shrink-0">当てる場所</label>
            <input id="slider-pos" type="range" min="0.18" max="0.78" step="0.004" value="0.46" class="w-full" oninput="onControlInput()" />
            <span id="label-pos" class="text-sm font-black text-sky-300 w-12 text-right">中央</span>
          </div>
        </div>

        <!-- 2. レーザー本数＆表面の凸凹スライダー (4列) -->
        <div class="col-span-4 bg-slate-950/80 border border-slate-800 rounded-xl p-3 h-full flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-1.5">
              <span class="text-sm font-black text-amber-300">✨ レーザーの本数</span>
              <span class="text-xs font-bold text-slate-400">1本だと角度がよくわかる</span>
            </div>
            <div class="grid grid-cols-3 gap-1.5">
              <button id="btn-rays-1" onclick="setRayCount(1)" class="py-1.5 rounded-xl text-sm font-black bg-slate-800 text-slate-200 border border-slate-700">
                1本 (拡大向き)
              </button>
              <button id="btn-rays-5" onclick="setRayCount(5)" class="py-1.5 rounded-xl text-sm font-black bg-amber-500 text-slate-950 shadow">
                5本 (おすすめ)
              </button>
              <button id="btn-rays-7" onclick="setRayCount(7)" class="py-1.5 rounded-xl text-sm font-black bg-slate-800 text-slate-200 border border-slate-700">
                7本 (ワイド)
              </button>
            </div>
          </div>

          <!-- 凸凹スライダー -->
          <div class="flex items-center gap-2">
            <label class="text-sm font-extrabold text-slate-200 shrink-0">面の凸凹</label>
            <input id="slider-roughness" type="range" min="0" max="1" step="0.05" value="0.90" class="w-full slider-amber" oninput="onControlInput()" />
            <button onclick="changeBumpShape()" class="bg-slate-800 hover:bg-slate-700 text-xs font-black text-amber-300 px-2.5 py-1.5 rounded-lg border border-slate-700 shrink-0">
              🔄 形変更
            </button>
          </div>
        </div>

        <!-- 3. 補助線の表示切替スイッチ (3列) -->
        <div class="col-span-3 bg-slate-950/80 border border-slate-800 rounded-xl p-3 h-full flex flex-col justify-between">
          <div class="text-sm font-black text-emerald-300">📐 補助図形の表示</div>
          <label class="flex items-center gap-2.5 cursor-pointer text-sm font-extrabold text-slate-200">
            <input id="chk-tangents" type="checkbox" checked onchange="onControlInput()" class="w-5 h-5 accent-cyan-400 rounded" />
            <span>小さな鏡の傾き</span>
          </label>
          <label class="flex items-center gap-2.5 cursor-pointer text-sm font-extrabold text-slate-200">
            <input id="chk-normals" type="checkbox" checked onchange="onControlInput()" class="w-5 h-5 accent-emerald-400 rounded" />
            <span>法線（垂直な線）</span>
          </label>
          <label class="flex items-center gap-2.5 cursor-pointer text-sm font-extrabold text-slate-200">
            <input id="chk-angles" type="checkbox" checked onchange="onControlInput()" class="w-5 h-5 accent-amber-400 rounded" />
            <span>入射角＝反射角</span>
          </label>
        </div>

      </div>
    </section>

    <!-- ========== 右カラム：特大ミクロ拡大ルーペ ＆ 視覚ポイント図解 (4列) ========== -->
    <aside id="right-column" class="col-span-4 flex flex-col gap-3 min-h-0 h-full">

      <!-- 上段：特大ミクロ拡大ルーペ（凸凹の1点では必ず「入射角＝反射角」になる証拠！） -->
      <div class="flex-1 min-h-0 bg-slate-900 rounded-2xl border-2 border-cyan-500/40 p-3 flex flex-col justify-between shadow-xl">
        <!-- ルーペヘッダーと光線選択ボタン -->
        <div class="flex items-center justify-between gap-2 shrink-0">
          <div class="flex items-center gap-2">
            <span class="bg-cyan-500 text-slate-950 font-black px-2.5 py-1 rounded-lg text-sm shadow">
              🔎 ミクロ拡大図
            </span>
            <h2 class="text-base font-black text-white">凸凹の１か所を拡大！</h2>
          </div>
          <div id="ray-select-group" class="flex items-center gap-1"></div>
        </div>

        <!-- 特大ミクロキャンバス -->
        <div class="relative flex-1 min-h-0 my-2 bg-slate-950 rounded-2xl border-2 border-slate-800 overflow-hidden">
          <canvas id="microCanvas" class="w-full h-full block"></canvas>
          <div id="micro-slope-badge" class="absolute top-2.5 left-3 bg-slate-900/90 border border-cyan-400/50 px-3 py-1 rounded-xl text-sm font-black text-cyan-300 shadow">
            光線 ③ の場所：面の傾き +12°
          </div>
        </div>

        <!-- 入射角 ＝ 反射角 の特大デジタルメーター -->
        <div class="grid grid-cols-11 gap-2 items-center bg-slate-950 border border-slate-800 rounded-2xl p-2.5 shrink-0">
          <div class="col-span-5 bg-rose-950/60 border-2 border-rose-500/50 rounded-xl px-3 py-1.5 flex items-center justify-between">
            <span class="text-sm font-black text-rose-200">入射角</span>
            <span id="big-inc-deg" class="text-2xl font-black text-rose-400">35°</span>
          </div>

          <div class="col-span-1 text-center text-2xl font-black text-emerald-400">
            ＝
          </div>

          <div class="col-span-5 bg-amber-950/60 border-2 border-amber-500/50 rounded-xl px-3 py-1.5 flex items-center justify-between">
            <span class="text-sm font-black text-amber-200">反射角</span>
            <span id="big-ref-deg" class="text-2xl font-black text-amber-300">35°</span>
          </div>
        </div>
      </div>

      <!-- 下段：大きくわかりやすい図解カード（ワンタップ切替） -->
      <div class="h-64 shrink-0 bg-slate-900 rounded-2xl border-2 border-slate-800 p-3 flex flex-col justify-between shadow-xl">
        <!-- カード切替タブ -->
        <div class="grid grid-cols-2 gap-2 bg-slate-950 p-1 rounded-xl border border-slate-800 shrink-0">
          <button id="card-tab-1" onclick="switchGuideCard(1)" class="py-1.5 rounded-lg text-sm font-black bg-indigo-600 text-white shadow">
            💡 なぜ色んな方向へ？
          </button>
          <button id="card-tab-2" onclick="switchGuideCard(2)" class="py-1.5 rounded-lg text-sm font-black text-slate-400 hover:text-white">
            👀 なぜ物が見える？
          </button>
        </div>

        <!-- カード1：なぜ乱反射はいろいろな方向へ飛ぶのか？（大きなイラスト付き） -->
        <div id="guide-card-1" class="flex-1 min-h-0 flex flex-col justify-between pt-2">
          <div class="grid grid-cols-12 gap-2.5 items-center flex-1">
            <div class="col-span-6 h-full bg-slate-950 rounded-xl border border-slate-800 p-1.5 flex items-center justify-center">
              <svg viewBox="0 0 220 125" class="w-full h-full">
                <!-- 凸凹の地面 -->
                <path d="M 10 98 Q 40 72, 72 96 T 138 88 T 210 95 L 210 120 L 10 120 Z" fill="#334155" />
                <path d="M 10 98 Q 40 72, 72 96 T 138 88 T 210 95" fill="none" stroke="#cbd5e1" stroke-width="3" />
                <!-- 小さな鏡プレート3枚 -->
                <line x1="36" y1="84" x2="68" y2="94" stroke="#22d3ee" stroke-width="5" stroke-linecap="round" />
                <line x1="94" y1="98" x2="128" y2="88" stroke="#22d3ee" stroke-width="5" stroke-linecap="round" />
                <line x1="154" y1="88" x2="188" y2="96" stroke="#22d3ee" stroke-width="5" stroke-linecap="round" />
                <!-- 入射光 -->
                <line x1="20" y1="18" x2="52" y2="89" stroke="#f43f5e" stroke-width="3.5" />
                <line x1="78" y1="18" x2="110" y2="93" stroke="#f43f5e" stroke-width="3.5" />
                <line x1="138" y1="18" x2="170" y2="92" stroke="#f43f5e" stroke-width="3.5" />
                <!-- 反射光 -->
                <line x1="52" y1="89" x2="108" y2="20" stroke="#fbbf24" stroke-width="3.5" />
                <line x1="110" y2="93" x2="88" y2="16" stroke="#fbbf24" stroke-width="3.5" />
                <line x1="170" y2="92" x2="212" y2="24" stroke="#fbbf24" stroke-width="3.5" />
                <text x="14" y="115" fill="#67e8f9" font-size="13" font-weight="900">▲ 傾きが違う小さな鏡の集まり！</text>
              </svg>
            </div>
            <div class="col-span-6 space-y-1.5">
              <div class="text-sm font-black text-amber-300 leading-snug">
                凸凹な面 ＝「傾いた小さな鏡」の集まり！
              </div>
              <p class="text-xs sm:text-sm font-bold text-slate-200 leading-relaxed">
                当たる場所によって<strong class="text-cyan-300">面の傾き（法線の向き）</strong>が違うため、反射の法則通りに跳ね返ると<strong class="text-amber-300">あらゆる方向</strong>へ光が広がります。
              </p>
            </div>
          </div>
        </div>

        <!-- カード2：なぜ教室のどこからでも黒板や本が見えるのか？ -->
        <div id="guide-card-2" class="hidden flex-1 min-h-0 flex flex-col justify-between pt-2">
          <div class="grid grid-cols-12 gap-2.5 items-center flex-1">
            <div class="col-span-6 h-full bg-slate-950 rounded-xl border border-slate-800 p-1.5 flex items-center justify-center">
              <svg viewBox="0 0 220 125" class="w-full h-full">
                <!-- 物体（本・黒板） -->
                <rect x="60" y="95" width="100" height="14" fill="#e2e8f0" rx="4" />
                <text x="72" y="122" fill="#f8fafc" font-size="12" font-weight="900">本・スクリーン</text>
                <!-- 光源 -->
                <circle cx="30" cy="26" r="12" fill="#f43f5e" />
                <line x1="40" y1="34" x2="95" y2="95" stroke="#f43f5e" stroke-width="3" />
                <line x1="40" y1="34" x2="115" y2="95" stroke="#f43f5e" stroke-width="3" />
                <line x1="40" y1="34" x2="135" y2="95" stroke="#f43f5e" stroke-width="3" />
                <!-- 四方八方への乱反射 -->
                <line x1="95" y1="95" x2="75" y2="26" stroke="#fbbf24" stroke-width="3" stroke-dasharray="4 2" />
