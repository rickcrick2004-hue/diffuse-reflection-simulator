  <!-- ==================== JavaScript（物理計算・特大キャンバス描画・アニメーション制御） ==================== -->
  <script>
    // =========================================================================
    // アプリ全体の状態（State）
    // =========================================================================
    const state = {
      viewMode: 'compare',      // 'compare' | 'single' | 'summary'
      laserAngleDeg: 42,        // レーザーの入射角度（15°〜80°）
      laserPosRatio: 0.46,      // レーザーが狙う横位置比率（0.18〜0.78）
      rayCount: 5,              // 1, 5, 7
      roughness: 0.90,          // 表面の凸凹度（0.0: 鏡 〜 1.0: 乱反射）
      showTangents: true,       // 小さな鏡の傾きプレート表示
      showNormals: true,        // 法線（垂直な点線）表示
      showAngles: true,         // 入射角・反射角の扇形表示
      selectedRayIdx: 2,        // ミクロ拡大図で拡大中の光線番号 (0始まり)
      particlePhase: 0,         // 光の粒（レーザーパルス）の移動フェーズ
      shootProgress: 2.0,       // スロー発射進行度 (0.0 -> 1.0: 入射, 1.0 -> 2.0: 反射)
      isShooting: false,        // スロー発射アニメ中かどうか
      autoSweep: false,         // 左右自動スキャンモードON/OFF
      sweepDir: 1,              // 自動スキャンの移動方向
      bumpSeed: 1,              // 凸凹波形のシード値
      isDragging: false,        // キャンバス上のドラッグ操作中フラグ
      activeRaysData: []        // ミクロ拡大図に渡す光線計算結果
    };

    // 凸凹面を作る合成サイン波パラメータ（どの点でも滑らかに接線と法線が求まる）
    let surfaceWaves = [];

    function buildSurfaceWaves(seed) {
      const s = seed * 1.65;
      surfaceWaves = [
        { freq: 5.0 * Math.PI,  amp: 10.5, phase: s + 0.3 },
        { freq: 9.0 * Math.PI,  amp: 6.8,  phase: s * 2.1 + 1.4 },
        { freq: 15.0 * Math.PI, amp: 4.0,  phase: s * 3.2 + 2.7 }
      ];
    }
    buildSurfaceWaves(state.bumpSeed);

    // 正規化座標 u ∈ [0, 1] における凸凹の高さ dy と傾き slope (dy/dx) を計算
    function getSurfaceGeometry(u, spanWidth, roughness) {
      if (roughness <= 0.01) {
        return { dy: 0, slope: 0 };
      }
      let dy = 0;
      let d_dy_du = 0;
      for (const w of surfaceWaves) {
        const arg = w.freq * u + w.phase;
        dy += roughness * w.amp * Math.sin(arg);
        d_dy_du += roughness * w.amp * w.freq * Math.cos(arg);
      }
      // 傾きが極端になりすぎないようスケーリングしつつ、反射方向の違いがはっきり出る値に設定
      const slope = (d_dy_du / spanWidth) * 0.58;
      return { dy: dy * 0.72, slope };
    }

    // =========================================================================
    // Canvas の初期化とリサイズ処理
    // =========================================================================
    const simCanvas = document.getElementById('simCanvas');
    const ctx = simCanvas.getContext('2d');
    const microCanvas = document.getElementById('microCanvas');
    const microCtx = microCanvas.getContext('2d');

    function resizeAllCanvases() {
      const container = document.getElementById('canvas-container');
      const dpr = window.devicePixelRatio || 1;
      if (container) {
        const rect = container.getBoundingClientRect();
        simCanvas.width = Math.max(300, Math.floor(rect.width * dpr));
        simCanvas.height = Math.max(220, Math.floor(rect.height * dpr));
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      }
      if (microCanvas && microCanvas.parentElement) {
        const mRect = microCanvas.parentElement.getBoundingClientRect();
        microCanvas.width = Math.max(200, Math.floor(mRect.width * dpr));
        microCanvas.height = Math.max(140, Math.floor(mRect.height * dpr));
        microCtx.setTransform(dpr, 0, 0, dpr, 0, 0);
      }
    }

    window.addEventListener('resize', resizeAllCanvases);

    // =========================================================================
    // 画面モード・コントロール操作関数
    // =========================================================================
    function setViewMode(mode) {
      state.viewMode = mode;
      const tabCompare = document.getElementById('tab-compare');
      const tabSingle = document.getElementById('tab-single');
      const tabSummary = document.getElementById('tab-summary');

      const simCol = document.getElementById('sim-column');
      const rightCol = document.getElementById('right-column');
      const summarySec = document.getElementById('summary-section');
      const singleSwitch = document.getElementById('single-mode-switch');

      const activeCls = 'px-4 py-2 rounded-xl text-sm font-black transition-all bg-sky-500 text-white shadow-md';
      const inactiveCls = 'px-4 py-2 rounded-xl text-sm font-black transition-all text-slate-300 hover:text-white';

      tabCompare.className = mode === 'compare' ? activeCls : inactiveCls;
      tabSingle.className = mode === 'single' ? activeCls : inactiveCls;
      tabSummary.className = mode === 'summary' ? activeCls : inactiveCls;

      if (mode === 'summary') {
        simCol.classList.add('hidden');
        rightCol.classList.add('hidden');
        summarySec.classList.remove('hidden');
      } else {
        simCol.classList.remove('hidden');
        rightCol.classList.remove('hidden');
        summarySec.classList.add('hidden');

        if (mode === 'single') {
          singleSwitch.classList.remove('hidden');
        } else {
          singleSwitch.classList.add('hidden');
          if (state.roughness < 0.35) {
            state.roughness = 0.90;
            document.getElementById('slider-roughness').value = 0.90;
          }
        }
        setTimeout(resizeAllCanvases, 25);
      }
    }

    function setRoughnessPreset(val) {
      state.roughness = val;
      document.getElementById('slider-roughness').value = val;
      updateSinglePresetHighlight();
      triggerShootAnimation();
    }

    function updateSinglePresetHighlight() {
      const r = state.roughness;
      const bMirror = document.getElementById('preset-mirror');
      const bWave = document.getElementById('preset-wave');
      const bRough = document.getElementById('preset-rough');
      if (!bMirror) return;

      const onCls = 'px-3.5 py-1.5 rounded-xl text-sm font-black bg-sky-500 text-white shadow';
      const offCls = 'px-3.5 py-1.5 rounded-xl text-sm font-black text-slate-300 hover:bg-slate-800';
      bMirror.className = r <= 0.08 ? onCls : offCls;
      bWave.className = (r > 0.08 && r < 0.65) ? onCls : offCls;
      bRough.className = r >= 0.65 ? onCls : offCls;
    }

    function onControlInput() {
      state.laserAngleDeg = parseFloat(document.getElementById('slider-angle').value);
      state.laserPosRatio = parseFloat(document.getElementById('slider-pos').value);
      state.roughness = parseFloat(document.getElementById('slider-roughness').value);
      state.showTangents = document.getElementById('chk-tangents').checked;
      state.showNormals = document.getElementById('chk-normals').checked;
      state.showAngles = document.getElementById('chk-angles').checked;

      document.getElementById('label-angle').textContent = `${Math.round(state.laserAngleDeg)}°`;
      document.getElementById('label-pos').textContent = `${Math.round(state.laserPosRatio * 100)}%`;
      updateSinglePresetHighlight();
    }

    function setLaserPreset(angle, pos) {
      state.laserAngleDeg = angle;
      state.laserPosRatio = pos;
      document.getElementById('slider-angle').value = angle;
      document.getElementById('slider-pos').value = pos;
      onControlInput();
      triggerShootAnimation();
    }

    function setRayCount(count) {
      state.rayCount = count;
      state.selectedRayIdx = Math.floor(count / 2);
      [1, 5, 7].forEach(c => {
        const btn = document.getElementById(`btn-rays-${c}`);
        if (c === count) {
          btn.className = 'py-1.5 rounded-xl text-sm font-black bg-amber-500 text-slate-950 shadow';
        } else {
          btn.className = 'py-1.5 rounded-xl text-sm font-black bg-slate-800 text-slate-200 border border-slate-700';
        }
      });
      renderRaySelectionButtons();
      triggerShootAnimation();
    }

    function renderRaySelectionButtons() {
      const group = document.getElementById('ray-select-group');
      group.innerHTML = '';
      const circledNums = ['①', '②', '③', '④', '⑤', '⑥', '⑦'];
      for (let i = 0; i < state.rayCount; i++) {
        const btn = document.createElement('button');
        const isSelected = i === state.selectedRayIdx;
        btn.className = isSelected
          ? 'px-2.5 py-1 rounded-lg text-sm font-black bg-cyan-400 text-slate-950 shadow'
          : 'px-2.5 py-1 rounded-lg text-sm font-bold bg-slate-800 text-slate-300 hover:bg-slate-700';
        btn.textContent = circledNums[i] || (i + 1);
        btn.onclick = () => {
          state.selectedRayIdx = i;
          renderRaySelectionButtons();
        };
        group.appendChild(btn);
      }
    }

    function changeBumpShape() {
      state.bumpSeed += 1;
      buildSurfaceWaves(state.bumpSeed);
      triggerShootAnimation();
    }

    function triggerShootAnimation() {
      state.shootProgress = 0.0;
      state.isShooting = true;
    }

    function toggleAutoSweep() {
      state.autoSweep = !state.autoSweep;
      const btn = document.getElementById('btn-auto-sweep');
      if (state.autoSweep) {
        btn.className = 'bg-amber-500 text-slate-950 border-2 border-amber-300 text-sm font-black px-3.5 py-1.5 rounded-xl transition flex items-center gap-1 shadow-lg';
        btn.innerHTML = '<span>🔄 左右に自動スキャン：ON</span>';
      } else {
        btn.className = 'bg-slate-800 hover:bg-slate-700 border-2 border-slate-600 text-amber-300 text-sm font-black px-3.5 py-1.5 rounded-xl transition flex items-center gap-1';
        btn.innerHTML = '<span>🔄 左右に自動スキャン：OFF</span>';
      }
    }

    function startSingleScanDemo() {
      setViewMode('single');
      setRoughnessPreset(0.90);
      setRayCount(1);
      if (!state.autoSweep) {
        toggleAutoSweep();
      }
    }

    function switchGuideCard(num) {
      const tab1 = document.getElementById('card-tab-1');
      const tab2 = document.getElementById('card-tab-2');
      const card1 = document.getElementById('guide-card-1');
